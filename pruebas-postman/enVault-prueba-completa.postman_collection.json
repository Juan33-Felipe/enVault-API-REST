    {
      "name": "3. Bóveda: CRUD en PRODUCCION",
      "item": [
        {
          "name": "Crear secreto DB_PASSWORD",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 201', () => pm.expect(pm.response.code).to.eql(201));",
                  "const b = pm.response.json();",
                  "pm.test('Devuelve id, keyName y createdAt', () => { pm.expect(b).to.have.property('id'); pm.expect(b.keyName).to.eql('DB_PASSWORD'); pm.expect(b).to.have.property('createdAt'); });",
                  "pm.test('No devuelve el valor del secreto', () => { pm.expect(b).to.not.have.property('value'); pm.expect(b).to.not.have.property('encryptedValue'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKeyProd}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/secrets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "secrets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keyName\": \"DB_PASSWORD\",\n  \"value\": \"superSecreta123\"\n}",
              "options": {
                "raw": {
