{
  "info": {
    "name": "enVault API — prueba completa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Prueba de punta a punta de enVault. Ejecuta la colección completa con Run collection, sin cambiar el orden. Cada ejecución crea entornos nuevos con un sufijo único, así que se puede repetir sin vaciar la base de datos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "prodName",
      "value": ""
    },
    {
      "key": "qaName",
      "value": ""
    },
    {
      "key": "apiKeyProd",
      "value": ""
    },
    {
      "key": "apiKeyQa",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Entornos (Environments)",
      "item": [
        {
          "name": "Crear entorno PRODUCCION",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36).toUpperCase();",
                  "pm.collectionVariables.set('runId', id);",
                  "pm.collectionVariables.set('prodName', 'PRODUCCION_' + id);",
                  "pm.collectionVariables.set('qaName', 'QA_' + id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 201', () => pm.expect(pm.response.code).to.eql(201));",
                  "const b = pm.response.json();",
                  "pm.test('Devuelve una apiKey env_…', () => pm.expect(/^env_[0-9a-f]{48}$/.test(b.apiKey)).to.eql(true));",
                  "pm.test('El nombre se guarda en mayúsculas', () => pm.expect(b.name).to.eql(pm.collectionVariables.get('prodName').toUpperCase()));",
                  "pm.test('No expone el hash de la apiKey', () => pm.expect(b).to.not.have.property('apiKeyHash'));",
                  "pm.collectionVariables.set('apiKeyProd', b.apiKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/environments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "environments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{prodName}}\",\n  \"description\": \"Entorno de producción\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear entorno QA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 201', () => pm.expect(pm.response.code).to.eql(201));",
                  "pm.collectionVariables.set('apiKeyQa', pm.response.json().apiKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/environments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "environments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{qaName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar entornos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "const list = pm.response.json();",
                  "pm.test('Es una lista', () => pm.expect(list).to.be.an('array'));",
                  "pm.test('Incluye los dos entornos creados', () => { const names = list.map((e) => e.name); pm.expect(names).to.include(pm.collectionVariables.get('prodName')); pm.expect(names).to.include(pm.collectionVariables.get('qaName')); });",
                  "pm.test('Ningún entorno expone su apiKey ni su hash', () => list.forEach((e) => { pm.expect(e).to.not.have.property('apiKey'); pm.expect(e).to.not.have.property('apiKeyHash'); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/environments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "environments"
              ]
            }
          }
        },
        {
          "name": "Entorno duplicado → 409",
