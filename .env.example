# Copia este archivo como .env y completa los valores. El .env NUNCA se sube al repo.

PORT=3000

# PostgreSQL (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=envault
DB_PASSWORD=envault
DB_NAME=envault

# Clave maestra de cifrado: 64 caracteres hex (32 bytes). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se cambia, los secretos ya guardados no se podrán descifrar.
ENCRYPTION_MASTER_KEY=
